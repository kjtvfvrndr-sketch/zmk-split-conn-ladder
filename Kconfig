	range -1 499 if ZMK_SPLIT_CONN_LADDER_COMPUTED_STEPS
	range 0 499
	default -1 if ZMK_SPLIT_CONN_LADDER_COMPUTED_STEPS
	default 29
	help
	  Computed mode: -1, the default there, puts the step on the ramp
	  from ACTIVE's latency to the one USB_POWER_PERIPHERAL_SYNC_DELAY_MS
	  gives, and a value sets it: the other computed USB power steps then
	  lie on straight lines through it. Checked at build time on
	  ACTIVE_DEFAULT_INTERVAL, and held to MIN_SUPERVISION_WINDOWS and
	  MAX_RETURN_MS at run time when ACTIVE is longer.
	  Table mode: the USB power step's latency.

config ZMK_SPLIT_CONN_LADDER_STEP1_USB_POWER_SUPERVISION_TIMEOUT
