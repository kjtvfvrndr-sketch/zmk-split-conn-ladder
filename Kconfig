	range 0 3200 if ZMK_SPLIT_CONN_LADDER_COMPUTED_STEPS
	range 10 3200
	default 0 if ZMK_SPLIT_CONN_LADDER_COMPUTED_STEPS
	default 800
	help
	  Computed mode: 0, the default there, takes STEPS_SUPERVISION_TIMEOUT.
	  Table mode: the step's timeout.

config ZMK_SPLIT_CONN_LADDER_STEP1_USB_POWER_INTERVAL
