#
# Both halves.
#
config ZMK_SPLIT_CONN_LADDER_EARLY_SLEEP
	bool "Deep sleep early when there is nothing to work for"
	depends on ZMK_SPLIT_BLE
	depends on ZMK_SPLIT_CONN_LADDER || !ZMK_SPLIT_ROLE_CENTRAL
	depends on HAS_POWEROFF
	default n if ZMK_USB_LOGGING
	default y
	select POWEROFF
	select PM_DEVICE
	select ZMK_PM_DEVICE_SUSPEND_RESUME
	help
	  The module's own deep sleep, apart from ZMK's: it works with
	  ZMK_SLEEP off, and ZMK_IDLE_SLEEP_TIMEOUT does not affect it. It
	  counts only idle time (ZMK_IDLE_TIMEOUT, 30 s by default, then this
	  much more) and puts the half into the same System OFF as ZMK's sleep,
	  woken the same way -- a key, the trackball, a cable.

	  The central half sleeps after ABSENCE_WAIT_MS of idle
	    - with no computer: none connected on the active Bluetooth
	      profile, and none that configured it over USB (a computer
	      asleep counts, a charger or a power bank does not) -- on any
	      power, cable or battery;
	    - with EARLY_SLEEP_WITHOUT_PERIPHERAL, without the other half too,
	      unless it is on USB power with a computer there.
	  The peripheral half sleeps after ABSENCE_WAIT_MS of idle without the
	  central -- on USB power too: without it the half has nothing to do.

	  The wait counts from the later of entering idle and the reason
	  arising, and starts again whenever a computer, the other half or
	  USB power comes or goes. While the active profile is open for
	  pairing, the central waits EARLY_SLEEP_BLE_PAIRING_WAIT_MS instead.

	  Off by default in a USB-logging build (ZMK_USB_LOGGING), so that
	  the log does not end when the other half goes away; y turns it on
	  there too.

config ZMK_SPLIT_CONN_LADDER_ABSENCE_WAIT_MS
	int "Wait before sleeping early or searching at low power (ms, 0: auto)"
	depends on ZMK_SPLIT_CONN_LADDER_EARLY_SLEEP || ZMK_SPLIT_CONN_LADDER_LOW_POWER_PERIPHERAL_SEARCH
	range 0 3600000
	default 0
	help
	  W: how long a half goes on without something it needs before it
	  saves power. One number for two uses:

	    - the early sleep (EARLY_SLEEP): W of idle with a reason to sleep
	      -- no computer, no other half -- and the half sleeps;
	    - the low-power search (LOW_POWER_PERIPHERAL_SEARCH): W of the
	      full search (or the middle one) for a missing other half, and
	      the central switches to listening now and then.

	  One number on purpose. The other half, once it has lost this one,
	  waits its own W before its early sleep, so the full or the middle
	  search runs for as long as that half is still awake and calling;
	  after that it is asleep, and the key that wakes it makes it call
	  again, which the low-power search hears. With 0 the central's W
	  (35 s) is not shorter than the other half's (30 or 35 s).

	  0 picks it: the settings-save formula below, or 30 s, whichever is
	  longer -- 35 s with ZMK's defaults on the central half, 30 s on a
	  peripheral half with nothing to save, 35 s on one with underglow,
	  backlight or ZMK_EXT_POWER (on by default in ZMK; a board's
	  own configuration may turn it off).

	  The formula keeps a sleep from cutting off a settings write: ZMK
	  writes a changed Bluetooth profile, output, underglow, backlight or
	  external power state ZMK_SETTINGS_SAVE_DEBOUNCE (60 s) after the
	  change, and idle starts ZMK_IDLE_TIMEOUT (30 s) after the last key,
	  so W >= 60 s - 30 s + 5 s = 35 s. It applies on the central half
	  always (with SETTINGS), and on a peripheral half with
	  ZMK_RGB_UNDERGLOW, ZMK_BACKLIGHT or ZMK_EXT_POWER. Underglow that
	  turns off by itself (ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE, _AUTO_OFF_USB)
	  starts that write at the moment it does, with no key at all, so the
	  sleep then also waits ZMK_SETTINGS_SAVE_DEBOUNCE + 5 s after
	  entering idle or after a cable goes in or out.

	  A value set here must not be below the formula nor below 10000;
	  the build stops otherwise.

config ZMK_SPLIT_CONN_LADDER_TEST_SLEEP_AND_SEARCH_IGNORE_USB
	bool "TEST ONLY: early sleep and low-power search ignore USB (central half)"
	depends on ZMK_SPLIT_CONN_LADDER
	depends on ZMK_SPLIT_CONN_LADDER_EARLY_SLEEP || ZMK_SPLIT_CONN_LADDER_LOW_POWER_PERIPHERAL_SEARCH
	default n
	help
	  For testing with a USB log, never for daily use. A USB log needs a
	  computer on the cable, and that computer is exactly what keeps the
	  central half from sleeping early (it counts as a computer) and keeps
	  the full search for the other half on (the keys go to it). With this
	  on, the early sleep and the low-power search act as they do on
	  battery with no USB host: a USB host is neither a computer nor a
	  reason to search at full rate, USB power is no reason to stay awake,
	  and plugging or unplugging does not restart the count. A Bluetooth
	  host, the other half and the timers work as always, so every sleep
	  and search scenario can be watched in the log -- up to "early sleep
	  in 100 ms", where the half powers off, the log ends and the
	  trackball or a key wakes it, cable in or not.

	  The middle search (MIDDLE_PERIPHERAL_SEARCH_INTERVAL_MS) follows the
	  output as ZMK selected it, so &out picks the case: &out OUT_BLE with
	  a Bluetooth host connected -- the middle search, then the low-power
	  one; the keys on USB -- as with no host, ZMK's full search for
	  ABSENCE_WAIT_MS, then the low-power one.

	  The ladder is not affected: on USB power it still runs the USB power
	  steps (&ladder LADDER_ON forces the battery ones). The build warns
	  while this is on, and the log says so at boot.

#
# The PERIPHERAL half's report to the ladder.
#
menuconfig ZMK_SPLIT_CONN_LADDER_PERIPHERAL_USB_POWER_REPORT
	bool "Tell the central half whether this half is on USB power"
	depends on ZMK_SPLIT_BLE && !ZMK_SPLIT_ROLE_CENTRAL
	depends on SOC_NRF52840 || SOC_NRF52833 || SOC_NRF52820
	default y
	help
	  For the PERIPHERAL half; on by default. With it, the ladder on the
	  central half gives ACTIVE latency 0 while this half is on USB power
	  (nothing to save here), and holds ACTIVE when both halves are.
	  Without it the central counts this half as on battery.

	  Reads the nRF52840's VBUS detector once a second and publishes the
	  result as a small GATT characteristic; the central reads it on every
	  connect and is notified of changes. The cost is a timer wake-up per
	  second, well under a microamp.

	  The report also carries this half's uptime, which is how the
	  central tells this half's sleep (or any restart) from a lost link:
	  without it, backoff can take a sleep followed by a quick key press
	  on this half for a step that failed.

if ZMK_SPLIT_CONN_LADDER_PERIPHERAL_USB_POWER_REPORT

module = ZMK_SPLIT_CONN_LADDER_PERIPHERAL_USB_POWER_REPORT
module-str = zmk_split_conn_ladder_usb_power_report
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_SPLIT_CONN_LADDER_PERIPHERAL_USB_POWER_REPORT

menuconfig ZMK_SPLIT_CONN_LADDER_PERIPHERAL_CLOSE_LINK_BEFORE_SLEEP
	bool "Close the split link before this half goes to sleep"
	depends on ZMK_SPLIT_BLE && !ZMK_SPLIT_ROLE_CENTRAL
	default y
	help
	  For the PERIPHERAL half; on by default. ZMK's sleep powers a half
	  off without closing the link, so the central learns of it only when
	  its supervision timeout runs out -- 4 s at ACTIVE, 8 s at a step --
	  and meanwhile anything it sends this way (a layer colour pushed to
	  this half's LED, say) waits in the Bluetooth buffers it shares with
	  the reports to the computer: a trackball on the central stalls.

	  With this on, the SLEEP event closes the link first ("remote user
	  terminated", reason 0x13 on the central) and waits for the close to
	  complete -- a few tens of milliseconds at ACTIVE. The wait is limited
	  to two connection intervals and a margin, never less than 1.5 s nor
	  more than the supervision timeout and the margin. The central knows at once, starts looking
	  for this half, and does not count the loss against the ladder.
	  Waking is unchanged.

	  Other threads run during the close. An LED driver that paints from
	  a thread of its own must keep its LEDs dark once it has seen SLEEP,
	  or a colour arriving meanwhile lights them again for the whole sleep.

if ZMK_SPLIT_CONN_LADDER_PERIPHERAL_CLOSE_LINK_BEFORE_SLEEP

module = ZMK_SPLIT_CONN_LADDER_PERIPHERAL_CLOSE_LINK_BEFORE_SLEEP
module-str = zmk_split_conn_ladder_close_link
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_SPLIT_CONN_LADDER_PERIPHERAL_CLOSE_LINK_BEFORE_SLEEP

if ZMK_SPLIT_CONN_LADDER_EARLY_SLEEP && !ZMK_SPLIT_ROLE_CENTRAL

module = ZMK_SPLIT_CONN_LADDER_EARLY_SLEEP
module-str = zmk_split_conn_ladder_early_sleep
source "subsys/logging/Kconfig.template.log_config"

endif

#
# Independent of the ladder: lives here only so that one module covers both.
#
menuconfig ZMK_USB_RESEND_KEYS_AFTER_WAKE
	bool "Get the keyboard state to a USB host woken by a key"
	depends on ZMK_USB
	help
	  Two things go wrong in stock ZMK when a key wakes a sleeping computer
	  over USB.

	  The waking key is never typed: while the bus is suspended,
	  usb_hid.c asks for a remote wakeup and drops the report. The log
	  shows "FAILED TO SEND OVER USB: -11", or nothing when the wakeup
	  request itself succeeds.

	  And the wake takes the host longer than ZMK thinks. The nRF driver
	  reports the bus resumed as soon as the keyboard starts signalling,
	  but a computer in system sleep may not poll for seconds. ZMK's next
	  report is parked in the endpoint and every later one is dropped, so
	  the host can end up holding a key-down whose key-up never arrived:
	  a key that repeats until the next keystroke.

	  With this on, after every wake of the bus -- a key, the trackball,
	  a layer key or the host itself may have caused it; plugging the
	  cable in is not one -- the module
	  watches the keys until the host is seen reading. If a key report was
	  dropped, it first compares what the host will hold with what is
	  held now. If they differ -- a waking key
	  still down, a release the host never got -- the current snapshot is
	  written; if they match, nothing is (an empty report parked for
	  nothing would take the slot the next keystroke needs). Until the host
	  is seen reading, every key change is written again after ZMK's own,
	  retrying while the endpoint is busy. A HID keyboard report is a
	  snapshot of what is held, so this repeats nothing: a waking key still
	  held is typed once, and nothing is left stuck. Mouse reports carry
	  movement and are never re-sent.

	  Key changes that happened entirely while the host was not reading
	  cannot be recovered -- only one report fits in the endpoint. The log
	  counts them.

if ZMK_USB_RESEND_KEYS_AFTER_WAKE

config ZMK_USB_RESEND_KEYS_AFTER_WAKE_DELAY_MS
	int "Delay between the resume and the first write (ms)"
	range 0 500
	default 10
	help
	  The snapshot is taken when the write runs, so shorter catches
	  quicker taps. ZMK itself writes as soon as the bus reads as resumed.

config ZMK_USB_RESEND_KEYS_AFTER_WAKE_GIVE_UP_MS
	int "Give up if the host is not reading after this long (ms)"
	range 1000 120000
	default 30000
	help
	  A computer waking from deep sleep can take several seconds before it
	  polls the keyboard. For this long the module keeps checking whether
	  the host reads; past it, it stops checking and logs a warning. If a
	  report of its own may still be unread by then, it stays armed rather
	  than walking away: the next key change is re-sent once the host
	  reads, or its release would be refused behind that report.

module = ZMK_USB_RESEND_KEYS_AFTER_WAKE
module-str = zmk_usb_resend_keys_after_wake
source "subsys/logging/Kconfig.template.log_config"

endif # ZMK_USB_RESEND_KEYS_AFTER_WAKE
