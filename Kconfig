	default 29

config ZMK_SPLIT_CONN_LADDER_S1_USB_TIMEOUT
	int "Step 1 on USB power: supervision timeout (10 ms units)"
	depends on ZMK_SPLIT_CONN_LADDER_USB_STEPS
	range 10 3200
	default 800

